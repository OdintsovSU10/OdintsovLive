############
# Secrets
############

# Пароль PostgreSQL (сгенерируйте надёжный пароль)
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT секрет (минимум 32 символа, используйте: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# JWT время жизни в секундах (3600 = 1 час)
JWT_EXP=3600

# Сгенерируйте ключи на https://supabase.com/docs/guides/self-hosting#api-keys
# или используйте скрипт generate-keys.sh
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

############
# URLs
############

# Внешний URL вашего сайта
SITE_URL=https://yourname.synology.me
API_EXTERNAL_URL=https://yourname.synology.me

# Дополнительные разрешённые URL для редиректов (через запятую)
ADDITIONAL_REDIRECT_URLS=

############
# Auth
############

# Отключить регистрацию новых пользователей
DISABLE_SIGNUP=false

# Включить email регистрацию
ENABLE_EMAIL_SIGNUP=true

# Автоподтверждение email (без отправки письма)
ENABLE_EMAIL_AUTOCONFIRM=true

# Разрешить анонимных пользователей
ENABLE_ANONYMOUS_USERS=false

############
# SMTP (опционально, для отправки email)
############

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_ADMIN_EMAIL=admin@example.com

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,storage
