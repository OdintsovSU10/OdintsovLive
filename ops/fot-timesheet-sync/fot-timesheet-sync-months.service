[Unit]
Description=Resync OdintsovLive timesheet from FOT for current and previous month
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/sites/fot-token-api/sync.env
ExecStart=/opt/sites/fot-token-api/run-fot-timesheet-sync.sh months
TimeoutStartSec=120
Nice=10

[Install]
WantedBy=multi-user.target
